{
  "expo": {
    "name": "Nomi",
    "slug": "nomi-mobile",
    "version": "0.1.0",
    "scheme": "nomi",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/app-icon/icon.png",
    "android": {
      "package": "com.nomi.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon/adaptive-icon.png",
        "backgroundColor": "#713BB3"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withRiveNitroPackages",
      "./plugins/withWindowsShortBuildPaths",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Nomi usa o microfone para ouvir o compromisso que você descreve.",
          "speechRecognitionPermission": "O Nomi transforma sua fala em texto para registrar compromissos."
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "web": {
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3107dc62-339f-40c6-8548-764edfa5605c"
      }
    }
  }
}
