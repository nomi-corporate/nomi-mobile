{
  "expo": {
    "name": "Nomi",
    "slug": "nomi-mobile",
    "version": "0.1.0",
    "scheme": "nomi",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.nomi.app"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "web": {
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
